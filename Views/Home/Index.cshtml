@model HomeKeep.Models.MaintenanceTask?

@{
    ViewData["Title"] = "Maintenance Dashboard";
}

<div class="text-center">
    <h1 class="display-4">HomeKeep Maintenance Planner</h1>
    <p>Keep your home’s maintenance tasks organized in one place.</p>
</div>

<h2 class="h5 mt-4">Featured maintenance task</h2>

@if (Model != null)
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <partial name="_MaintenanceTaskCard" model="Model" />
        </div>
    </div>
}
else
{
    <p>No maintenance tasks are available yet.</p>
}

@section Scripts {
<script src="https://jgrissom.github.io/dotnet-web-dev/week-07/homework-checks.js"></script>}