@model HomeKeep.Models.MaintenanceTask?

@{
    ViewData["Title"] = "Maintenance Dashboard";
}

<div class="p-4 p-md-5 mb-4 bg-body-tertiary rounded-3">
    <h1 class="display-4">Maintenance made simple.</h1>
    <p class="lead">
        Organize your home’s maintenance tasks and keep a history of the work you’ve done.
    </p>
    <p>
        See what needs attention, add tasks for each room, and record maintenance
        details so you can find them later.
    </p>
    <a asp-controller="MaintenanceTasks"
       asp-action="Index"
       class="btn btn-primary">
        View Tasks
    </a>
</div>

<h2 class="h5 mt-4">Featured maintenance task</h2>

@if (Model != null)
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <partial name="_MaintenanceTaskCard" model="Model" />
        </div>
    </div>
}
else
{
    <p>No maintenance tasks are available yet.</p>
}

@section Scripts {
<script src="https://jgrissom.github.io/dotnet-web-dev/week-11/homework-checks.js"></script>
}