@{
    ViewData["Title"] = "About";
}

<h1>About HomeKeep</h1>

<p class="lead">
    HomeKeep helps you organize recurring home maintenance and keep a
    history of completed work.
</p>

<p>
    Create tasks for different rooms, set maintenance intervals, and
    record who performed the work, when it happened, and any useful notes.
</p>

<p>
    Built by Jake Ferguson for the .NET Web Development course at WCTC.
    HomeKeep is a student project, and its records can be changed by visitors.
</p>

<a asp-controller="MaintenanceTasks"
   asp-action="Index"
   class="btn btn-primary">
    Browse Tasks
</a>