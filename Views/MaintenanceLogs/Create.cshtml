@model MaintenanceLogFormViewModel

@{
    ViewData["Title"] = "Log maintenance";
}

<h1>Log maintenance</h1>
<p class="text-muted">Record the work performed on a maintenance task.</p>

<form asp-action="Create" method="post" class="col-md-8">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="MaintenanceLog.MaintenanceTaskId"
               class="form-label"></label>
        <select asp-for="MaintenanceLog.MaintenanceTaskId"
                asp-items="Model.MaintenanceTasks"
                class="form-select">
            <option value="">— choose a task —</option>
        </select>
        <span asp-validation-for="MaintenanceLog.MaintenanceTaskId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaintenanceLog.CompletedOn"
               class="form-label"></label>
        <input asp-for="MaintenanceLog.CompletedOn" class="form-control" />
        <span asp-validation-for="MaintenanceLog.CompletedOn"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaintenanceLog.PerformedBy"
               class="form-label"></label>
        <input asp-for="MaintenanceLog.PerformedBy" class="form-control" />
        <span asp-validation-for="MaintenanceLog.PerformedBy"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaintenanceLog.Notes" class="form-label"></label>
        <textarea asp-for="MaintenanceLog.Notes"
                  class="form-control"
                  rows="5"></textarea>
        <span asp-validation-for="MaintenanceLog.Notes"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save maintenance log</button>
    <a asp-controller="MaintenanceTasks"
       asp-action="Index"
       class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}