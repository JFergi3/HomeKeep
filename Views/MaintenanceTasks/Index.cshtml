@model List<MaintenanceTask>

@{
    ViewData["Title"] = "Maintenance Tasks";
}

<h1>Maintenance Tasks</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Add Task</a>

@if (!Model.Any())
{
    <p class="text-muted">
        No maintenance tasks yet. Select <strong>Add Task</strong> to create your first one.
    </p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var task in Model)
        {
            <div class="col">
                <partial name="_MaintenanceTaskCard" model="task" />
            </div>
        }
    </div>
}