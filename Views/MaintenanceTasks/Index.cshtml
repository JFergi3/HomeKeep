@model List<MaintenanceTask>

@{
    ViewData["Title"] = "Maintenance Tasks";
}

<h1>Home Maintenance Tasks</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Add Maintenance Task</a>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var task in Model)
    {
        <div class="col">
            <partial name="_MaintenanceTaskCard" model="task" />
        </div>
    }
</div>