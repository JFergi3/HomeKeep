@model HomeKeep.Models.MaintenanceTask

@{
    ViewData["Title"] = Model.Name;
}

<a asp-action="Index" class="d-inline-block mb-3">
    ← Back to Tasks
</a>

<h1>Maintenance Task Details</h1>

<dl>
    <dt>Name</dt>
    <dd>@Model.Name</dd>

    <dt>Description</dt>
    <dd>@Model.Description</dd>

    @if (Model.MaintenanceNotes != null)
{
    <dt>Maintenance notes</dt>
    <dd>@Model.MaintenanceNotes</dd>
}

    <dt>Room</dt>
    <dd>@Model.Room</dd>

    <dt>Frequency</dt>
    <dd>Every @Model.FrequencyDays days</dd>

    <dt>Completed</dt>
    <dd>@(Model.IsCompleted ? "Yes" : "No")</dd>
</dl>

<div class="d-flex flex-wrap gap-5 mt-3 mb-4">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-dark">
        Edit Task
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-outline-danger">
        Delete Task
    </a>
</div>

<section class="maintenance-history p-4 my-4 rounded-3">

    <h2 class="h4">Maintenance history</h2>

<p>
    <a asp-controller="MaintenanceLogs"
       asp-action="Create"
       asp-route-maintenanceTaskId="@Model.Id"
       class="btn btn-primary">
        Log maintenance
    </a>
</p>


@if (Model.MaintenanceLogs.Count > 0)
{
    <div class="list-group mb-4">
        @foreach (var log in Model.MaintenanceLogs.OrderByDescending(log => log.CompletedOn))
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <strong>@log.PerformedBy</strong>
                    <span class="text-muted small">
                        @log.CompletedOn.ToString("MMMM d, yyyy")
                    </span>
                </div>
                <p class="mb-0">@log.Notes</p>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">No maintenance has been logged for this task yet.</p>
}
</section>
