@model HomeKeep.Models.MaintenanceTask

@{
    ViewData["Title"] = Model.Name;
}

<h1>Maintenance Task Details</h1>

<dl>
    <dt>Name</dt>
    <dd>@Model.Name</dd>

    <dt>Description</dt>
    <dd>@Model.Description</dd>

    <dt>Room</dt>
    <dd>@Model.Room</dd>

    <dt>Frequency</dt>
    <dd>Every @Model.FrequencyDays days</dd>

    <dt>Completed</dt>
    <dd>@(Model.IsCompleted ? "Yes" : "No")</dd>
</dl>

<div class="my-4">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-secondary">Edit Task</a>
</div>

<a asp-action="Delete"
   asp-route-id="@Model.Id"
   class="btn btn-outline-danger ms-2">Delete Task</a>

<a asp-controller="MaintenanceTasks"
   asp-action="Index">
    Back to Maintenance Tasks
</a>