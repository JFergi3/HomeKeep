@model ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1>Something went wrong</h1>
    <p class="lead">
        We couldn’t load this page. Try again in a moment,
        or return to your maintenance tasks.
    </p>
    <a asp-controller="MaintenanceTasks"
       asp-action="Index"
       class="btn btn-primary">
        Back to Tasks
    </a>
</div>